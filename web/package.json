{
  "name": "halone-web",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk": "pnpm --dir ../sdk install && pnpm --dir ../sdk build",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@halone/sdk": "link:../sdk/packages/sdk"
    }
  }
}
